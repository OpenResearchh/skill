{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenResearchh/experiment-protocol/github_bound_proposal.schema.json",
  "title": "GitHubBoundProposal",
  "description": "Chain-neutral metadata binding an on-chain mining proposal to a GitHub pull request candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "github",
    "proposal",
    "trial",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_bundle_id"],
      "properties": {
        "protocol_bundle_id": { "type": "string", "minLength": 1 },
        "chain": { "type": "string", "minLength": 1 },
        "project_id": {
          "type": ["integer", "string", "null"],
          "description": "Settlement-layer project id when available."
        },
        "token_address": {
          "type": ["string", "null"],
          "description": "Legacy token/project address when the chain adapter uses one."
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repo", "base_branch", "base_sha", "head_branch", "head_sha"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "base_branch": { "type": "string", "minLength": 1 },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "head_branch": { "type": "string", "minLength": 1 },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "pr_number": { "type": ["integer", "null"], "minimum": 1 },
        "pr_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "stake", "reward_recipient", "status"],
      "properties": {
        "proposal_id": {
          "type": ["integer", "string"],
          "description": "On-chain proposal id. String is allowed for chain-neutral adapters."
        },
        "stake": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "reward_recipient": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["submitted", "pending", "reviewable", "approved", "rejected", "released", "merged", "unknown"]
        },
        "settlement_tx": { "type": ["string", "null"] }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "primary_metric_name",
        "claimed_metric",
        "direction"
      ],
      "properties": {
        "trial_id": { "type": "string", "minLength": 1 },
        "primary_metric_name": { "type": "string", "minLength": 1 },
        "claimed_metric": { "type": "number" },
        "claimed_aggregate_score": { "type": ["string", "null"] },
        "direction": { "type": "string", "enum": ["minimize", "maximize"] },
        "hypothesis": { "type": ["string", "null"] }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_hash", "benchmark_log_hash"],
      "properties": {
        "code_cid": { "type": ["string", "null"] },
        "code_hash": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
        },
        "benchmark_log_cid": { "type": ["string", "null"] },
        "benchmark_log_hash": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
        },
        "verification_result_cid": { "type": ["string", "null"] }
      }
    }
  }
}
