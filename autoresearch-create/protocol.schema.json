{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenResearchh/experiment-protocol/protocol.schema.json",
  "title": "ExperimentLoopProtocol",
  "description": "Versioned experiment-loop contract: environment, mutable surface, execution, measurement, provenance. Use schemaKind \"protocol\" for finalized bundles; \"discoveryDraft\" for LLM discovery output prior to merge and validation.",
  "oneOf": [
    { "$ref": "#/$defs/ProtocolDocument" },
    { "$ref": "#/$defs/DiscoveryDraftDocument" }
  ],
  "$defs": {
    "ProtocolVersion": {
      "type": "string",
      "enum": ["1.0", "1.1"],
      "description": "1.0 = original schema. 1.1 = MAY use environment.constraints.networkAllowlist, structured {kind,args} setupCommands, and environment.sandbox. Version is purely a discoverability signal so verifiers know whether they need a newer skill to faithfully reproduce the bundle; both versions remain hash-compatible because new fields are optional."
    },
    "SchemaKind": {
      "type": "string",
      "enum": ["protocol", "discoveryDraft"]
    },
    "ArchetypeId": {
      "type": "string",
      "enum": [
        "ml_train",
        "rl_loop",
        "benchmark_opt",
        "build_test",
        "solver_compete",
        "pipeline_job",
        "inference_serving",
        "unknown"
      ]
    },
    "Eligibility": {
      "type": "string",
      "enum": ["eligible", "needs_harness", "ineligible"]
    },
    "Confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "RepoRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "defaultBranch": { "type": "string" },
        "cloneUrl": { "type": "string", "format": "uri" }
      }
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetype", "eligibility", "purposeStatement"],
      "properties": {
        "archetype": { "$ref": "#/$defs/ArchetypeId" },
        "eligibility": { "$ref": "#/$defs/Eligibility" },
        "repo": { "$ref": "#/$defs/RepoRef" },
        "purposeStatement": {
          "type": "string",
          "description": "One-sentence statement of what should improve across iterations."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "protocolBundleId": {
          "type": "string",
          "description": "Immutable id for handoff between phase 1 (authoring) and phase 2 (experimenters)."
        }
      }
    },
    "EnvironmentConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "noNewDependencies": { "type": "boolean" },
        "networkPolicy": {
          "type": "string",
          "enum": ["sandbox", "full", "offline", "unknown"],
          "description": "sandbox/offline/unknown -> --network=none in the harness (unknown fails closed). full -> bridged egress, but the harness refuses to launch unless the operator sets ARAH_ALLOW_FULL_NETWORK=1, since networkAllowlist is not yet enforced on egress."
        },
        "networkAllowlist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional egress allowlist (host or host:port) for networkPolicy=full. The harness MAY enforce; validators MUST treat undeclared hosts as a fraud signal."
        }
      }
    },
    "SetupCommand": {
      "oneOf": [
        {
          "type": "string",
          "description": "Legacy free-form shell snippet executed via `bash -c` inside the sandbox."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "args"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["pip", "uv", "npm", "pnpm", "yarn", "cargo", "make", "bash", "sh"],
              "description": "Closed set of entrypoints the harness knows. The harness maps each kind to a fixed argv[0] so protocol authors cannot inject a different binary."
            },
            "args": {
              "type": "array",
              "items": { "type": "string" },
              "description": "argv tail passed to the entrypoint. For kind=bash/sh this is one string under -c."
            }
          }
        }
      ]
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setupCommands", "constraints"],
      "properties": {
        "osHints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "e.g. darwin-arm64, linux-x86_64"
        },
        "packageManagers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "e.g. uv, pip, npm, cargo"
        },
        "setupCommands": {
          "type": "array",
          "items": { "$ref": "#/$defs/SetupCommand" },
          "description": "Ordered preparation steps. Each entry is either a free-form string (legacy) or a structured {kind,args} object. All entries run inside the sandbox; none are evaluated on the host."
        },
        "assetPrep": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Data downloads, cache paths, checksum notes."
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional sandbox preferences (advisory; the miner's local config wins).",
          "properties": {
            "image": { "type": "string", "description": "Container image reference for podman/docker runtimes." },
            "cpus": { "type": "string" },
            "memory": { "type": "string" },
            "pids": { "type": "integer", "minimum": 1 }
          }
        },
        "constraints": { "$ref": "#/$defs/EnvironmentConstraints" }
      }
    },
    "MutableSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedGlobs", "forbiddenGlobs", "allowedKinds"],
      "properties": {
        "allowedGlobs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Glob patterns agents may edit. Must not overlap forbiddenGlobs (validate out-of-band)."
        },
        "forbiddenGlobs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowedKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["code_edit", "config_edit"]
          },
          "minItems": 1
        }
      }
    },
    "ImmutableHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "rationale"],
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths or globs defining eval/data harness; do not modify."
        },
        "rationale": { "type": "string" }
      }
    },
    "StopCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "wall_clock",
            "max_steps",
            "epochs",
            "until_metric",
            "fixed_suite"
          ]
        },
        "trainingSecondsBudget": {
          "type": "number",
          "minimum": 0,
          "description": "Wall-clock training budget when type is wall_clock."
        },
        "excludeCompilationFromBudget": {
          "type": "boolean",
          "description": "If true, compile/startup may sit outside the counted budget."
        },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "epochs": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "Execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "cwd", "stopCondition", "hardTimeoutSeconds"],
      "properties": {
        "command": {
          "type": "string",
          "description": "Primary experiment command (single shell-invokable line)."
        },
        "cwd": { "type": "string", "default": "." },
        "stopCondition": { "$ref": "#/$defs/StopCondition" },
        "hardTimeoutSeconds": {
          "type": "number",
          "minimum": 1,
          "description": "Kill switch for hung runs."
        },
        "determinism": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seedPolicy": {
              "type": "string",
              "enum": ["optional", "required"]
            },
            "seedDerivation": { "$ref": "#/$defs/SeedDerivation" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "SeedDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "description": "How the per-trial seed is chosen. `fiat_shamir` derives it from a hash of the candidate's own mutable surface, so the seed changes whenever the code changes. That makes the evaluation inputs impossible to tune against without also moving them, and it needs no secret held-out set — which matters because a permissionless verifier network has nowhere to keep one. Miner and verifier derive the same seed from the same code, so the run stays reproducible.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "fixed", "fiat_shamir"],
          "description": "none: harness sets no seed. fixed: always `fixedSeed`. fiat_shamir: derived from the candidate code."
        },
        "envVar": {
          "type": "string",
          "default": "ARAH_TRIAL_SEED",
          "description": "Environment variable the harness exports the derived seed into."
        },
        "fixedSeed": {
          "type": "integer",
          "minimum": 0,
          "description": "Seed value when mode is `fixed`."
        },
        "seedBits": {
          "type": "integer",
          "enum": [32, 64],
          "default": 64,
          "description": "Width of the derived seed."
        },
        "sourcePaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Globs hashed to derive the seed when mode is `fiat_shamir`. Defaults to mutableSurface.allowedGlobs when omitted."
        },
        "salt": {
          "type": "string",
          "description": "Optional project-specific salt mixed into the derivation (e.g. the protocol hash) so seeds do not collide across projects."
        },
        "notes": { "type": "string" }
      }
    },
    "MiningLoop": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional outer mining-session limits (autoresearch-mine). Per-trial limits stay in execution.",
      "properties": {
        "maxTrials": {
          "type": "integer",
          "minimum": 1,
          "description": "Stop after this many completed trials (each append to trials.jsonl counts)."
        },
        "maxSessionWallSeconds": {
          "type": "number",
          "minimum": 1,
          "description": "Wall-clock budget for the whole mining session from first trial start."
        },
        "maxConsecutiveNonImprovements": {
          "type": "integer",
          "minimum": 1,
          "description": "Stop after this many consecutive trials without a new local best."
        },
        "stopAfterSuccessfulPr": {
          "type": "boolean",
          "description": "If true, stop the outer loop after a successful gh PR (exit 0)."
        },
        "onChainProjectId": {
          "type": "integer",
          "minimum": 0,
          "description": "0G Galileo ProjectRegistry project id (autoresearch-mine: sync_registry_frontier.py). Env ARAH_PROJECT_ID overrides when set."
        }
      }
    },
    "MetricExtract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["regex", "json_pointer", "junit", "pytest_summary", "custom"]
        },
        "pattern": {
          "type": "string",
          "description": "Regex with first capture group = metric value when kind is regex."
        },
        "jsonPointer": { "type": "string" },
        "exampleStdout": {
          "type": "string",
          "description": "Golden snippet for parser tests."
        },
        "notes": { "type": "string" }
      }
    },
    "PrimaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "extract"],
      "properties": {
        "name": { "type": "string" },
        "direction": {
          "type": "string",
          "enum": ["minimize", "maximize"]
        },
        "extract": { "$ref": "#/$defs/MetricExtract" }
      }
    },
    "SecondaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction"],
      "properties": {
        "name": { "type": "string" },
        "direction": {
          "type": "string",
          "enum": ["minimize", "maximize"]
        },
        "extract": { "$ref": "#/$defs/MetricExtract" }
      }
    },
    "Sampling": {
      "type": "object",
      "additionalProperties": false,
      "description": "How many times a scored run is repeated and how the repeats are reduced to one number. A single run of a wall-clock or throughput benchmark is dominated by host noise, so scoring one run makes noise indistinguishable from discovery. Miner and verifier both use these values.",
      "properties": {
        "warmupTrials": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Trials run and discarded before measurement begins, to absorb cold caches and JIT warmup."
        },
        "measuredTrials": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "Trials whose metrics are kept and reduced by `aggregator`."
        },
        "aggregator": {
          "type": "string",
          "enum": ["median", "mean", "min", "max"],
          "default": "median",
          "description": "Reduction over measured trials. `median` is the default because it is robust to a single outlier trial in either direction."
        },
        "maxRelativeStdDev": {
          "type": "number",
          "minimum": 0,
          "description": "Optional. If set and the measured coefficient of variation exceeds it, the run is reported as too noisy to score rather than being scored."
        }
      }
    },
    "Measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryMetric", "baselinePolicy"],
      "properties": {
        "primaryMetric": { "$ref": "#/$defs/PrimaryMetric" },
        "sampling": { "$ref": "#/$defs/Sampling" },
        "minScoreImprovementBips": {
          "type": "integer",
          "minimum": 0,
          "default": 100,
          "description": "Minimum relative improvement over the current best, in basis points (100 = 1%), for a candidate to count as an improvement. Set this above the benchmark's measured noise floor so that run-to-run variance cannot be submitted as a discovery."
        },
        "secondaryMetrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/SecondaryMetric" }
        },
        "baselinePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["establishOnHardware", "sameDataSnapshot"],
          "properties": {
            "establishOnHardware": { "type": "boolean" },
            "sameDataSnapshot": { "type": "boolean" },
            "baselineNotes": { "type": "string" }
          }
        }
      }
    },
    "ResultsLog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path", "columns"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["tsv", "csv", "jsonl"]
        },
        "path": { "type": "string" },
        "columns": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "GitWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branchPattern": { "type": "string" },
        "commitScope": { "type": "string" },
        "pathPrefix": {
          "type": "string",
          "description": "Monorepo: only stage paths under this prefix."
        },
        "stagingExample": { "type": "string" }
      }
    },
    "GitHubVerification": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional GitHub-first verification hints for projects that use PRs and Actions as the coordination layer.",
      "properties": {
        "enabled": { "type": "boolean" },
        "requiredChecks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "GitHub check names that must pass before settlement-backed merge."
        },
        "metadataBlock": {
          "type": "string",
          "default": "openresearch-proposal",
          "description": "Fenced code block info string containing GitHubBoundProposal JSON in PR bodies."
        },
        "autoMerge": { "type": "boolean", "default": false },
        "proposalFirst": { "type": "boolean", "default": true }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultsLog"],
      "properties": {
        "resultsLog": { "$ref": "#/$defs/ResultsLog" },
        "gitWorkflow": { "$ref": "#/$defs/GitWorkflow" },
        "githubVerification": { "$ref": "#/$defs/GitHubVerification" },
        "baselineArtifactPath": {
          "type": "string",
          "description": "Optional path to stored baseline log for phase-2 handoff."
        }
      }
    },
    "Safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oomPolicy": {
          "type": "string",
          "enum": ["reduce_batch", "fail", "unknown"]
        },
        "crashStatus": {
          "type": "string",
          "enum": ["crash", "discard", "retry"]
        }
      }
    },
    "AgentRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simplicityCriterion": { "type": "boolean" },
        "autonomy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "noAskHumanToContinue": { "type": "boolean" }
          }
        },
        "experimentTimeoutNotes": { "type": "string" },
        "logRedirectExample": { "type": "string" }
      }
    },
    "ArchetypeExtensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ml_train": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "dataSnapshot": { "type": "string" },
            "evalTokens": { "type": "integer" },
            "hardwareNotes": { "type": "string" }
          }
        },
        "build_test": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "testCommand": { "type": "string" },
            "testSubset": { "type": "string" },
            "flakePolicy": { "type": "string" }
          }
        },
        "rl_loop": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "envId": { "type": "string" },
            "episodeHorizon": { "type": "integer" },
            "numSeeds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "ProtocolDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaKind",
        "protocolVersion",
        "meta",
        "environment",
        "mutableSurface",
        "immutableHarness",
        "execution",
        "measurement",
        "provenance",
        "safety",
        "agentRules"
      ],
      "properties": {
        "schemaKind": { "const": "protocol" },
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "meta": { "$ref": "#/$defs/Meta" },
        "environment": { "$ref": "#/$defs/Environment" },
        "mutableSurface": { "$ref": "#/$defs/MutableSurface" },
        "immutableHarness": { "$ref": "#/$defs/ImmutableHarness" },
        "execution": { "$ref": "#/$defs/Execution" },
        "measurement": { "$ref": "#/$defs/Measurement" },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "safety": { "$ref": "#/$defs/Safety" },
        "agentRules": { "$ref": "#/$defs/AgentRules" },
        "archetypeExtensions": { "$ref": "#/$defs/ArchetypeExtensions" },
        "miningLoop": { "$ref": "#/$defs/MiningLoop" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "meta": {
                "properties": { "eligibility": { "const": "eligible" } },
                "required": ["eligibility"]
              }
            },
            "required": ["meta"]
          },
          "then": {
            "properties": {
              "measurement": {
                "properties": {
                  "primaryMetric": {
                    "required": ["name", "direction", "extract"],
                    "properties": {
                      "extract": {
                        "required": ["kind"],
                        "properties": {
                          "pattern": { "type": "string", "minLength": 1 }
                        },
                        "allOf": [
                          {
                            "if": {
                              "properties": { "kind": { "const": "regex" } },
                              "required": ["kind"]
                            },
                            "then": { "required": ["pattern"] }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "DiscoveryDraftDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaKind",
        "protocolVersion",
        "meta",
        "environment",
        "execution",
        "measurement",
        "mutableSurface",
        "blockers"
      ],
      "properties": {
        "schemaKind": { "const": "discoveryDraft" },
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["archetypeGuess"],
          "properties": {
            "archetypeGuess": { "$ref": "#/$defs/ArchetypeId" },
            "archetypeConfidence": { "$ref": "#/$defs/Confidence" },
            "purposeStatementGuess": { "type": "string" },
            "repo": { "$ref": "#/$defs/RepoRef" }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "setupCommandsGuess": {
              "type": "array",
              "items": { "type": "string" }
            },
            "setupCommandsConfidence": { "$ref": "#/$defs/Confidence" },
            "osHintsGuess": {
              "type": "array",
              "items": { "type": "string" }
            },
            "packageManagersGuess": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commandGuess": { "type": "string" },
            "commandConfidence": { "$ref": "#/$defs/Confidence" },
            "cwdGuess": { "type": "string" },
            "stopConditionGuess": { "$ref": "#/$defs/StopCondition" },
            "stopConditionConfidence": { "$ref": "#/$defs/Confidence" }
          }
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metricGuess": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "direction": {
                  "type": "string",
                  "enum": ["minimize", "maximize"]
                },
                "extractGuess": { "$ref": "#/$defs/MetricExtract" },
                "extractConfidence": { "$ref": "#/$defs/Confidence" }
              }
            }
          }
        },
        "mutableSurface": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedGlobsGuess": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowedGlobsConfidence": { "$ref": "#/$defs/Confidence" },
            "forbiddenGlobsGuess": {
              "type": "array",
              "items": { "type": "string" }
            },
            "immutableHarnessPathsGuess": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ambiguities, missing README steps, multiple train entrypoints, secret deps."
        },
        "candidates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commands": {
              "type": "array",
              "items": { "type": "string" }
            },
            "trainScripts": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
